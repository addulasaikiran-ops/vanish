generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Share {
  id                   String    @id @default(cuid())
  tokenHash            String    @unique
  ciphertext           String
  iv                   String
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  destroyedAt          DateTime?
  status               String    @default("active")
  deleteAfterFirstView Boolean   @default(false)

  @@index([expiresAt])
}

model Report {
  id        String   @id @default(cuid())
  tokenHash String
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([createdAt])
}

model RateLimit {
  id              String   @id @default(cuid())
  keyHash         String   @unique
  windowStartedAt DateTime
  count           Int      @default(0)
  expiresAt       DateTime

  @@index([expiresAt])
}
